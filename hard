  class Solution {
public:
    int trap(vector<int>& height) {
        int water = 0;

        for(int i = 0 ; i <height.size(); i++){
        int left = 0, right = 0 ;

        for(int j = 0 ; j <=i ; j++)
        left = max (left,height[j]);

         for(int j = i ; j <height.size() ; j++)
        right = max (right,height[j]);

        water += min(left,right) - height[i];

    }
    return water;
    }
};

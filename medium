class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode* temp = head;
        int count = 0;

        while (temp != NULL){
            count++;
            temp = temp->next;
        }
        if(count ==n){
            return head->next;
        }
        temp = head;

        for(int i = 1 ; i < count-n; i++){
            temp = temp->next;
        }
        temp->next = temp->next->next;
        return head;
    }
};


